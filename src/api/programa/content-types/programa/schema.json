{
  "kind": "collectionType",
  "collectionName": "programas",
  "info": {
    "singularName": "programa",
    "pluralName": "programas",
    "displayName": "Programa"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "facultad": {
      "type": "string"
    },
    "nombre": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "nombre"
    },
    "tipo_programa": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tipo-programa.tipo-programa",
      "inversedBy": "programas"
    },
    "descripcion": {
      "type": "text"
    },
    "imagen": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "convocatoria": {
      "type": "boolean"
    },
    "objetivo_general": {
      "type": "text"
    },
    "objetivos_especificos": {
      "type": "text"
    },
    "perfil_posgraduado": {
      "type": "text"
    },
    "inversion": {
      "type": "component",
      "component": "shared.inversion",
      "repeatable": false
    },
    "modalidad": {
      "type": "enumeration",
      "enum": [
        "virtual",
        "semipresencial",
        "presencial"
      ]
    },
    "malla_curricular": {
      "type": "component",
      "component": "shared.malla-curricular",
      "repeatable": false
    }
  }
}
